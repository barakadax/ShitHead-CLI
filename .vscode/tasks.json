{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Debug",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-g",
        "-O0",
        "-static",
        "src/main.c",
        "src/debug.c",
        "-o",
        "a",
        "-lsodium",
        "-lm",
        "-lpthread"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}
